# Copy to .env and fill in. `mastra dev` reads .env.

# The model, as a Mastra model router string: by default OpenAI's GPT-6 Luna through OpenRouter,
# read with OPENROUTER_API_KEY. Any other Mastra router string still works, with that provider's
# key set instead (for example openai/gpt-6-luna and OPENAI_API_KEY).
HDTP_AGENT_MODEL=openrouter/openai/gpt-6-luna
OPENROUTER_API_KEY=

# The node's owner MCP: its internal listener and the /owner/mcp mount.
HDTP_OWNER_MCP_URL=http://127.0.0.1:8080/owner/mcp
# A named token made in the node's portal.
HDTP_OWNER_TOKEN=

# The endpoint's signing secret, shown once by the node's portal Webhooks page.
HDTP_WEBHOOK_SECRET=

# Seconds between sweeps (list_pending and get_inbox over every account): the safety net that
# answers what both the webhook and the wait_for_updates loop missed. The loop, not the sweep, keeps
# the node counting this agent as attached.
HDTP_RECONCILE_SECONDS=60

# How many agent-to-agent turns in a row a thread may have: a reply of this agent's to a message
# the contact's side labelled as an agent's. At the cap the agent stops answering the thread, so
# two agents cannot answer each other forever; a message labelled as a person's starts the count
# again.
HDTP_AGENT_TURN_CAP=3

# How many drafts one contact may have in an hour: every turn for their threads (a reply, an ask, a
# notice or none) and every answer to their requests alike, whatever the sender labels say, and
# whether or not the draft was sent or refused. A contact over it is left for the owner (their
# thread stays unread) until the hour moves on. Counted in memory: a restart starts every count
# again.
HDTP_AGENT_REPLIES_PER_HOUR=10

# Where the agent keeps its first-start time (first-start.json), read again at every start. Only
# messages that arrived after the first start are answered; the older backlog is left unread for the
# owner. A relative path is taken from where the agent was started. Delete the file to start afresh.
HDTP_AGENT_DATA_DIR=data

# Which contacts the agent answers. trusted (the default): only those whose trust the owner set to
# "May instruct your agent" (may_instruct) on the contact's page in the portal; every other
# contact's messages stay unread for the owner. all: every active contact, as a public demo node
# would. Any other value is taken as trusted.
HDTP_AGENT_ANSWER=trusted

# The persona: the agent's instructions, read when the agent starts.
HDTP_PERSONA_FILE=persona.md

# No usage analytics from the CLI, the server or Studio.
MASTRA_TELEMETRY_DISABLED=1
