{
  "name": "hdtp-gateway-agent",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source Mastra agent that answers an HDTP node's contacts on behalf of its owner",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "MASTRA_TELEMETRY_DISABLED=1 mastra dev",
    "build": "MASTRA_TELEMETRY_DISABLED=1 mastra build",
    "start": "MASTRA_TELEMETRY_DISABLED=1 mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "1.78.0",
    "@mastra/mcp": "2.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "mastra": "1.34.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
