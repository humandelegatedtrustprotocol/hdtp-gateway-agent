  },
  {
    "name": "get_inbox",
    "inputSchema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "the account to act on"
        }
      },
      "required": [
        "account_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_contacts",
    "inputSchema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "the account to act on"
        }
      },
      "required": [
        "account_id"
      ],
      "additionalProperties": false
    }
  },
  {
