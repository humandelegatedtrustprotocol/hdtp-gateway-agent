  {
    "name": "ask_owner",
    "inputSchema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "for_message_id": {
          "type": "string",
          "description": "the contact's message this is about"
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "description": "a root Column, a TLDR Text, KeyValue terms, 1-3 Choice ready replies, TextField last",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Column"
              },
              {
                "$ref": "#/$defs/Text"
              },
              {
                "$ref": "#/$defs/KeyValue"
              },
              {
                "$ref": "#/$defs/Choice"
              },
              {
                "$ref": "#/$defs/TextField"
              }
            ]
          }
        }
      },
      "required": [
        "account_id",
        "thread_id",
        "for_message_id",
        "components"
      ],
      "additionalProperties": false,
      "$defs": {
        "Column": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "component": {
              "const": "Column"
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "id",
            "component",
            "children"
          ],
          "additionalProperties": false
        },
        "Text": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "component": {
              "const": "Text"
            },
            "text": {
              "type": "string",
              "maxLength": 280
            }
          },
          "required": [
            "id",
            "component",
            "text"
          ],
          "additionalProperties": false
        },
        "KeyValue": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "component": {
              "const": "KeyValue"
            },
            "items": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "component",
            "items"
          ],
          "additionalProperties": false
        },
        "Choice": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "component": {
              "const": "Choice"
            },
            "label": {
              "type": "string",
              "maxLength": 80
            },
            "text": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "id",
            "component",
            "label",
            "text"
          ],
          "additionalProperties": false
        },
        "TextField": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "component": {
              "const": "TextField"
            },
            "label": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "id",
            "component",
            "label"
          ],
          "additionalProperties": false
        }
      }
    }
  },
