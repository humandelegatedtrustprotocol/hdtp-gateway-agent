          "description": "the message in the thread it is about, as read_thread names it; asking twice about one message is one notice",
          "minLength": 1,
          "type": "string"
        },
        "surface": {
          "description": "An A2UI v0.9.1 surface: a createSurface message naming catalogId https://hdtp.dev/a2ui/v0_9_1/catalogs/owner/catalog.json, then an updateComponents message for the same surfaceId. Its components list the root first, a Column of id \"root\", then the TLDR, the Text that is root's first child. Every component but root is placed exactly once: listed in root's children, or named as a Button's child, its label. Each Button, the Send too, has a label Text of its own as its child, and root's children do not list that Text. A notice holds only Text and KeyValue: it tells, and nothing answers it.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "createSurface": {
                  "additionalProperties": false,
                  "properties": {
                    "catalogId": {
                      "const": "https://hdtp.dev/a2ui/v0_9_1/catalogs/owner/catalog.json",
                      "type": "string"
                    },
                    "surfaceId": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "surfaceId",
                    "catalogId"
                  ],
                  "type": "object"
                },
                "version": {
                  "const": "v0.9.1",
                  "type": "string"
                }
              },
              "required": [
                "version",
                "createSurface"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "updateComponents": {
                  "additionalProperties": false,
                  "properties": {
                    "components": {
                      "allOf": [
                        {
                          "contains": {
                            "properties": {
                              "component": {
                                "const": "Column"
                              }
                            },
                            "required": [
                              "component"
                            ],
                            "type": "object"
                          },
                          "maxContains": 1,
                          "minContains": 0
                        }
                      ],
                      "items": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/Column"
                          },
                          {
                            "$ref": "#/$defs/Text"
                          },
                          {
                            "$ref": "#/$defs/KeyValue"
                          }
                        ]
                      },
                      "maxItems": 20,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "$ref": "#/$defs/Column"
                        },
                        {
                          "$ref": "#/$defs/Text"
                        }
                      ],
                      "type": "array"
                    },
                    "surfaceId": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "surfaceId",
                    "components"
                  ],
                  "type": "object"
                },
                "version": {
                  "const": "v0.9.1",
                  "type": "string"
                }
              },
              "required": [
                "version",
                "updateComponents"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        },
        "thread_id": {
          "description": "the thread the surface goes on, as get_inbox names it",
          "minLength": 1,
          "type": "string"
        }
