          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "thread_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "send_to_contact",
    "inputSchema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "contact_fpr": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "msg_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "description": "a new thread's topic, at most 256 bytes; refused for a thread that exists"
        }
      },
      "required": [
        "account_id",
        "contact_fpr",
        "msg_id",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_pending",
