  {
    "name": "list_asks",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string"
        },
        "contact_fpr": {
          "description": "one contact's asks and notices, oldest first",
          "type": "string"
        },
        "status": {
          "description": "open for the asks waiting on the owner; omit for every ask and notice",
          "type": "string"
        }
      },
      "required": [
        "account_id"
      ],
      "type": "object"
    }
  }
